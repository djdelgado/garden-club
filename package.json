{
  "name": "garden-club",
  "version": "0.1.0",
  "description": "Community garden club web application",
  "private": true,
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm run start",
    "lint": "cd frontend && npm run lint",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && python3 -m pytest",
    "local:up": "docker-compose up -d localstack && sleep 5 && bash scripts/setup-local.sh",
    "local:down": "docker-compose down",
    "local:api": "cd backend && sam build && sam local start-api",
    "dev:remote": "bash scripts/setup-develop.sh && npm run dev"
  },
  "workspaces": [
    "frontend"
  ]
}
